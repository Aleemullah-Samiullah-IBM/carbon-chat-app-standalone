{
  "name": "@agent-ui/common",
  "version": "1.0.0",
  "description": "Shared UI components and utilities for Agent UI",
  "type": "module",
  "main": "./dist/agent-ui-common.umd.js",
  "module": "./dist/agent-ui-common.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agent-ui-common.es.js",
      "require": "./dist/agent-ui-common.umd.js"
    },
    "./contexts/*": {
      "types": "./src/contexts/*.ts",
      "default": "./src/contexts/*"
    },
    "./components/*": {
      "types": "./src/components/*.ts",
      "default": "./src/components/*"
    },
    "./utilities/*": {
      "types": "./src/utilities/*.ts",
      "default": "./src/utilities/*"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*"
    },
    "./style.css": "./dist/common.css"
  },
  "publishConfig": {
    "registry": "https://na.artifactory.swg-devops.com/artifactory/api/npm/apic-prod-npm/"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "ui",
    "components",
    "shared",
    "agent-ui",
    "react"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.20",
    "@types/react": "^18.3.23 || ^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^30.0.5",
    "jsdom": "^26.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.63.0",
    "@carbon/pictograms-react": "^11.80.1",
    "@carbon/react": "^1.87.0",
    "axios": "^1.15.0",
    "classnames": "^2.5.1",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "react-i18next": "^17.0.2",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.89.2"
  },
  "overrides": {
    "mdast-util-to-hast": "13.2.1"
  }
}
